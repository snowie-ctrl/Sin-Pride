# Copy to .env beside this file and fill in. .env is never committed.
# plutus's admin routes (LAN only): the base address (http://<LAN host>:<port>) and the token in
# server/prideAdminConfig.json there
ADMIN_BASE=
ADMIN_TOKEN=
# "dry" prints the change report and sends nothing; "on" publishes. Only the owner turns it on.
PUBLISH=dry
